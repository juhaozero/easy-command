{
  "productName": "Easy Command",
  "identifier": "com.easycommand.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @easy-command/web dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @easy-command/web build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Easy Command",
        "width": 800,
        "height": 520
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/easy-command-engine"],
    "createUpdaterArtifacts": false,
    "publisher": "Easy Command",
    "shortDescription": "Windows 本地脚本工作台",
    "longDescription": "Windows 本地脚本工作台。支持脚本库、执行历史、调度与快捷键。",
    "copyright": "Copyright © 2026",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNTZFMkYxMUY2Mzk2NzYKUldSMmxtTWY4ZUpXRUFzb0I3NWJkVlN3VHRTcUEwL05JSWorL2JJMEZsWUkvdFdXNUVPSVpTZWoK",
      "endpoints": ["https://github.com/juhaozero/easy-command/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
